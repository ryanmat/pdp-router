# PDP Router Proxy configuration
# Copy to .env and fill in your own provider credentials, then run:
#   uv run pdp-router-proxy
# That entry point is what reads this file. Bare
# `uvicorn pdp_router._proxy:app` does NOT read it -- use
# `uv run --env-file .env uvicorn ...` if you launch that way. Real environment
# variables always win over this file, so a systemd EnvironmentFile is safe.
#
# One provider key is enough to start. With only ANTHROPIC_API_KEY set, the
# Gemini classifier falls back cross-lineage to Haiku and routing still works.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GCP_PROJECT=
GCP_LOCATION=us-east5
# OpenRouter (OpenAI-compatible) -- powers the OpenAI (GPT) and Qwen arms.
OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Bind address for `pdp-router-proxy`. There is NO authentication and no rate
# limiting: anything that can reach this port can spend your provider credits.
# Keep it on loopback unless you have put your own auth in front of it.
PROXY_HOST=127.0.0.1
PROXY_PORT=7741
PROXY_CLASSIFY_MODEL=gemini-2.5-flash-lite
PROXY_CLASSIFY_MAX_TOKENS=16
# Cross-lineage fallback when the primary classifier fails outright; one
# attempt before the (3, 0) no-panel collapse. Empty disables the fallback.
# PROXY_CLASSIFY_FALLBACK_MODEL=claude-haiku-4-5-20251001
# Trust weights + bandit posteriors (SQLite, read-only). Defaults to
# ~/.pdp-router/pdp_tracker.db; point at your pdp-tracker store.
# PROXY_TRUST_DB=
PROXY_TRUST_CACHE_TTL=300
PROXY_EXPLORE_RATE=0.10
# Routing-decision JSONL inbox (written per request for a downstream drain).
# Defaults to ~/.pdp-router/inbox.
# PROXY_ROUTING_INBOX_DIR=

# Routing mode. cascade (default) or bandit. ROUTING_MODE_OVERRIDES is parsed
# for per-domain routing but is currently unused by the proxy itself.
# ROUTING_MODE=cascade
# ROUTING_MODE_OVERRIDES={"kubernetes": {"mode": "bandit", "fraction": 0.10}}

# Feature toggles. Off by default; set to 1 to enable.
# PROXY_AUTOPANEL_ENABLED=0         # multi-model panel + chair synthesis on panel-worthy queries
# PROXY_STREAMING_ENABLED=0         # SSE streaming responses
# PROXY_PANEL_STREAMING_ENABLED=1   # stream the panel chair synthesis on the /openai/v1 faithful surface
# PROXY_EFFORT_ROUTING_ENABLED=0    # map the complexity score to a reasoning-effort level
# PROXY_WEB_SEARCH_ENABLED=0        # provider-native web search on the cascade path
# PROXY_ROUTE_FOOTER_ENABLED=0      # append a routed-model footer on the faithful surface
# PROXY_PANEL_TRANSCRIPT_ENABLED=0  # persist panel transcripts for offline eval
# PROXY_TOOL_PASSTHROUGH_ENABLED=0  # OpenAI tools/tool_calls passthrough on /openai/v1
# PROXY_STICKY_DRIVER_ENABLED=0     # tool conversations keep their first driver (cache continuity)
# PROXY_SPEND_CAP_ENABLED=0         # per-conversation budget: warn footer, then 429 refusal
# PROXY_PROMPT_CACHING_ENABLED=0    # Anthropic cache_control breakpoints on the tool paths
# PROXY_IMPLICIT_FEEDBACK_ENABLED=0 # grade the previous turn from the user's next message

# Per-conversation state + spend cap tuning.
# PROXY_CONVERSATION_CACHE_MAX=512
# PROXY_CONVERSATION_CACHE_TTL_S=7200
# PROXY_CONVERSATION_BUDGET_WARN_USD=1.00
# PROXY_CONVERSATION_BUDGET_MAX_USD=5.00

# Persistent user memory (all off by default; every flag fails closed). Needs
# the `memory` extra (`uv sync --extra memory`), then
# `uv run python -m pdp_router.memory warmup` once to download the two ONNX
# models (~150 MB) into PROXY_MEMORY_MODEL_DIR. A request never fails because
# of memory: a missing extra, missing models, or an unreadable store turns the
# feature off for that request and logs one traceback per cause.
# PROXY_MEMORY_ENABLED=0            # master: open memory.db, serve /v1/memory, load the models
# PROXY_MEMORY_SHADOW_ENABLED=0     # retrieve on a conversation's first turn and log the block; inject nothing
# Store and model paths. Defaults derive from the routing inbox: <inbox
# parent>/memory.db, then <memory.db parent>/models and <memory.db
# parent>/memory-shadow/ for the shadow log.
# PROXY_MEMORY_DB_PATH=
# PROXY_MEMORY_MODEL_DIR=
# PROXY_MEMORY_EMBED_MODEL=BAAI/bge-small-en-v1.5
# PROXY_MEMORY_RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
# PROXY_MEMORY_MIN_CE_SCORE=0.0     # cross-encoder floor; items scoring below it never reach the block
# PROXY_MEMORY_BLOCK_MAX_CHARS=1500 # whole lowest-ranked items are dropped to fit, never truncated
# PROXY_MEMORY_PIN_TTL_S=86400      # a conversation keeps its first-turn block this long
# PROXY_MEMORY_DEDUP_SIM=0.92       # cosine at or above this is a duplicate on write and in consolidate
# PROXY_MEMORY_WORKING_TTL_DAYS=90  # consolidate archives never-used working-tier items older than this

# Uplift gate (bandit mode only; empty baseline = off). When set, arms other
# than the baseline are sampleable only after their posterior beats the
# baseline's with probability >= MIN_PROB on >= MIN_OBS observations.
# PROXY_UPLIFT_BASELINE=
# PROXY_UPLIFT_MIN_PROB=0.75
# PROXY_UPLIFT_MIN_OBS=10

# Panel tuning (used when PROXY_AUTOPANEL_ENABLED=1).
# PROXY_AUTOPANEL_THRESHOLD=7       # min classifier panel_score to convene a panel
# PROXY_AUTOPANEL_N=3               # number of lineage-diverse members
# PROXY_CHAIR_MODEL=claude-sonnet-5
# Bounds chair thinking AND visible synthesis together -- the 5-generation
# Anthropic arms think by default, so a budget sized for a no-thinking chair
# truncates the answer.
# PROXY_CHAIR_MAX_TOKENS=8192

# Effort thresholds (used when PROXY_EFFORT_ROUTING_ENABLED=1).
# PROXY_EFFORT_SCORE_LOW_MAX=2
# PROXY_EFFORT_SCORE_HIGH_MIN=4

# OpenTelemetry (all optional). Without OTEL_EXPORTER_OTLP_ENDPOINT nothing is
# exported and the GenAI auto-instrumentation is not loaded at all.
# OTEL_SERVICE_NAME=pdp-router-proxy
# OTEL_SERVICE_NAMESPACE=pdp-router
# OTEL_ENVIRONMENT=lab
# OTEL_HOST_NAME=
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_EXPORTER_OTLP_HEADERS=
# OTEL_TRACING_ENABLED=true         # set false to disable export and instrumentation

# Record prompt and completion TEXT on spans. Off by default: turning it on
# ships the content of every request and response to your OTLP backend.
# OTEL_CAPTURE_CONTENT=0

# LangSmith works over plain OTLP -- no extra dependency, no SDK. Point the
# endpoint at their collector and pass the API key as a header:
# OTEL_EXPORTER_OTLP_ENDPOINT=https://api.smith.langchain.com/otel
# OTEL_EXPORTER_OTLP_HEADERS=x-api-key=<your-langsmith-key>,Langsmith-Project=pdp-router
# (EU/APAC/AWS deployments use eu./apac./aws. prefixes on that hostname.)
